    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: app.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "python": "python",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: run_manual_test.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/simulation/run_manual_test.py",
            "args": ["${workspaceFolder}/tests/fixtures/longa_pt_2min.wav", "${workspaceFolder}/tests/simulation/report.json"],
            "console": "integratedTerminal",
            "python": "python",
            "justMyCode": false
        }
    ]
}